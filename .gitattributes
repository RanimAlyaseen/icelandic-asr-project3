# Preserve the verified byte representation of manifests, references, and reports.
output/** -text whitespace=cr-at-eol
# Empty trailing TSV fields are part of the data.
output/*.tsv whitespace=cr-at-eol,-blank-at-eol

# Preserve the upstream bytes used by the release and audit checksums.
data/raw/samromur_21.05/README -text -whitespace
data/raw/samromur_21.05/metadata.tsv -text -whitespace
data/raw/samromur_21.05/md5s.txt -text -whitespace

# Both paths point at the same LFS object when audio bytes are identical.
data/raw/samromur_21.05/*/*/*.flac filter=lfs diff=lfs merge=lfs -text
data/cleaned/samromur-21.05-20h-v1/*/*/*.flac filter=lfs diff=lfs merge=lfs -text
models/mfcc_gmm_hmm/*.joblib filter=lfs diff=lfs merge=lfs -text
models/mfcc_gmm_hmm_aligned/*.joblib filter=lfs diff=lfs merge=lfs -text
